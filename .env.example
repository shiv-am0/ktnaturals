# Local development example only; never use this value in production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-only-replace-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SITE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/db.sqlite3
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# For production Compose replace every example with owner-approved values:
# DOMAIN=your-real-domain.example
# ACME_EMAIL=your-real-owner-email@example.com
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<unique random secret; never check in>
# DJANGO_ALLOWED_HOSTS=your-real-domain.example
# SITE_URL=https://your-real-domain.example
# WhatsApp number is set in /owner/settings/, not here.
