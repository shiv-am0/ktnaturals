# Install privately as /etc/ktnaturals-backup.env after reviewing OPERATIONS.md.
BACKUP_DEST=/var/backups/ktnaturals
BACKUP_KEEP=7
# Configure rclone as the same operator who runs the systemd service.
# Prefer an rclone crypt remote; this must be a DIFFERENT machine/provider.
OFFSERVER_DEST=encrypted-remote:ktnaturals
